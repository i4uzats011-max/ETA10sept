# MongoDB Atlas Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/cargo_tracker_v2?appName=Cluster0
MONGO_DB=cargo_tracker_v2

# Shipping Line Carrier Tracking API
JSON_CARGO_API_KEY=your_json_cargo_api_key_here

# Security & Authentication Passwords
ADMIN_PASSWORD=your_admin_password
EADMIN_PASSWORD=your_super_admin_password
BILLER_PASSWORD=your_biller_password
DISPATCHER_PASSWORD=your_dispatcher_password
DEV_ADMIN_PASSWORD=your_dev_admin_password
JWT_SECRET=your_super_secret_jwt_key_here
CRON_SECRET=your_cron_secret_bearer_token_here

# Upstash Redis (REST & TCP Connection)
UPSTASH_REDIS_REST_URL="https://your-upstash-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token_here"
REDIS_URL="rediss://default:your_upstash_token_here@your-upstash-db.upstash.io:6379"
